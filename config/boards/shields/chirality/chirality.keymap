#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 5    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
  behaviors {
    vol_encoder: vol_encoder {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
    };
    
    brightness_encoder: brightness_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp C_BRIGHTNESS_INC>, <&kp C_BRIGHTNESS_DEC>;
    };

    scroll_encoder: scroll_encoder {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&kp DOWN>, <&kp UP>;
    };

    window_scroll_encoder: window_scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp LG(LEFT)>, <&kp LG(RIGHT)>;
    };

    rgb_bri_encoder: rgb_bri_encoder {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&rgb_ug RGB_BRD>, <&rgb_ug RGB_BRI>;
    };

    rgb_hue_encoder: rgb_hue_encoder {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&rgb_ug RGB_HUD>, <&rgb_ug RGB_HUI>;
    };

    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      label = "HOMEROW_MODS";
      bindings = <&kp>, <&kp>;

      #binding-cells = <2>;
      tapping-term-ms = <300>;
      flavor = "tap-preferred";
      quick-tap-ms = <150>;
    };

    shift: shift {
      compatible = "zmk,behavior-hold-tap";
      label = "SHIFT";
      bindings = <&kp>, <&kp>;

      #binding-cells = <2>;
      tapping-term-ms = <300>;
      flavor = "tap-preferred";
      quick-tap-ms = <150>;
      require-prior-idle-ms = <(-1)>;
    };

    pp_n_p: pp_n_p {
      compatible = "zmk,behavior-tap-dance";
      label = "PP_N_P";
      #binding-cells = <0>;
      bindings = <&kp C_PLAY_PAUSE>, <&kp C_NEXT>, <&kp C_PREV>;

      tapping-term-ms = <400>;
    };

		hold_tap: hold_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "HOLD_TAP";
			bindings = <&kp>, <&kp>;

			#binding-cells = <2>;
			tapping-term-ms = <300>;
		};

    b_dec_inc: b_dec_inc {
      compatible = "zmk,behavior-tap-dance";
      label = "B_DEC_INC";
      #binding-cells = <0>;
      bindings = <&kp F21>, <&kp F22>; // In hyprland, F21 calls ddcutil setvcp 10 0 (decrease brightness), F22 calls ddcutil setvcp 10 100 (increase brightness)

      tapping-term-ms = <400>;
    };
  };

  combos {
    compatible = "zmk,combos";

    Escape {
      bindings = <&kp ESCAPE>;
      key-positions = <10 22>;
    };

    Gaming {
      bindings = <&tog 1>;
      key-positions = <10 14>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    base {
      label = "Base";
      bindings = <
        &kp Q        &kp W        &kp E           &kp R       &kp T      &kp Y    &kp U       &kp I           &kp O        &kp P
        &hm LCTRL A  &hm LMETA S  &shift LSHFT D  &hm LALT F  &kp G      &kp H    &hm LALT J  &shift RSHFT K  &hm RMETA L  &hm RCTRL SEMI
        &kp Z        &kp X        &kp C           &kp V       &kp B      &kp N    &kp M       &kp COMMA       &kp DOT      &kp FSLH
                     &kp LG(C)    &kp TAB         &mo 2       &kp SPACE  &kp RET  &mo 3       &mo 4           &pp_n_p
      >;
      sensor-bindings = <&window_scroll_encoder &vol_encoder>;
    };

    gaming {
      label = "Gaming";
      bindings = <
        &kp Q  &kp W      &kp E      &kp R  &kp T            &kp Y    &kp U  &kp I      &kp O    &kp P
        &kp A  &kp S      &kp D      &kp F  &kp G            &kp H    &kp J  &kp K      &kp L    &kp SEMI
        &kp Z  &kp X      &kp C      &kp V  &hold_tap TAB B  &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH
               &kp LG(C)  &kp LSHFT  &mo 2  &kp SPACE        &kp RET  &mo 3  &mo 4      &pp_n_p
      >;
      sensor-bindings = <&window_scroll_encoder &vol_encoder>;
    };

    numbers {
      label = "Numbers";
      bindings = <
        &kp F1        &kp F2        &kp F3           &kp F4       &kp F5     &kp F6    &kp F7       &kp F8           &kp F9        &kp F10
        &hm LCTRL N1  &hm LMETA N2  &shift LSHFT N3  &hm LALT N4  &kp N5     &kp N6    &hm LALT N7  &shift RSHFT N8  &hm RMETA N9  &hm LCTRL N0
        &kp GRAVE     &kp TILDE     &kp MINUS        &kp PLUS     &kp EQUAL  &kp BSLH  &kp PIPE     &kp UNDER        &trans        &trans
                      &kp LG(C)     &kp TAB          &mo 2        &kp SPACE  &kp RET   &mo 3        &mo 4            &b_dec_inc
      >;
      sensor-bindings = <&window_scroll_encoder &brightness_encoder>;
    };

    symbols {
      label = "Symbols";
      bindings = <
        &kp F11         &kp F12         &kp F13            &kp F14        &kp F15    &kp F16   &kp F17    &kp F18    &kp INSERT  &kp DELETE
        &hm LCTRL LPAR  &hm LMETA RPAR  &shift LSHFT LBRC  &hm LALT RBRC  &kp DQT    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT   &kp BSPC
        &kp LT          &kp GT          &kp LBKT           &kp RBKT       &kp SQT    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END     &kp K_CMENU
                        &kp LG(C)       &kp TAB            &mo 2          &kp SPACE  &kp RET   &mo 3      &mo 4      &pp_n_p
      >;
      sensor-bindings = <&window_scroll_encoder &vol_encoder>;
    };

    misc {
      label = "Misc";
      bindings = <
        &kp LCTRL        &kp LMETA        &kp LSHFT        &kp LALT         &kp CAPS      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &mkp RCLK
        &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp LCLK
        &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &bt BT_CLR    &mkp MB4        &mkp LCLK       &mkp RCLK     &mkp MCLK        &mkp MB5
                         &rgb_ug RGB_TOG  &kp TAB          &mo 2            &kp SPACE     &kp RET         &mo 3           &mo 4         &pp_n_p
      >;
      sensor-bindings = <&rgb_bri_encoder &rgb_hue_encoder>;
    };
  };
};

